    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "nuxt": "^2.0.0",
    "vue-server-renderer": "^2.6.11"
  },
  "devDependencies": {
    "gh-pages": "^6.1.1"
  }
}
