{
  "name": "Mahendra",
  "version": "1.0.0",
  "description": "Mahendra's personal webpage",
  "author": "rayzamgh",
  "private": true,
  "scripts": {
    "dev": "nuxt --hostname localhost --port 3333",
    "build": "nuxt build",
    "start": "nuxt start -p 3333",
